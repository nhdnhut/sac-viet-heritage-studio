# SẮC VIỆT STUDIO — Cấu hình môi trường Local
# Tùy chọn 1: Cấu hình API key qua biến môi trường (ưu tiên cao nhất)
# Hoặc Tùy chọn 2: Người dùng nhập trực tiếp trong giao diện Cài Đặt (Settings)
GEMINI_API_KEY=

# Cổng khởi chạy máy chủ cục bộ (Mặc định: 3000)
PORT=3000

# Địa chỉ ràng buộc cục bộ an toàn (Mặc định: 127.0.0.1)
HOSTNAME=127.0.0.1
